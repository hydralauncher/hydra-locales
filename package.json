{
  "name": "@hydralauncher/locales",
  "version": "0.2.0",
  "description": "Translations shared across Hydra projects",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydralauncher/hydra-locales.git"
  },
  "files": [
    "common",
    "languages.json"
  ],
  "exports": {
    "./common/*": "./common/*",
    "./languages.json": "./languages.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "format": "node scripts/validate.mjs --fix"
  },
  "engines": {
    "node": ">=22"
  }
}
